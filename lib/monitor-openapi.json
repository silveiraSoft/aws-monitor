{
  "openapi": "3.0.0",
  "info": {
    "title": "AWS Monitor Actions",
    "version": "1.0.0",
    "description": "Action group for AWS health monitoring agent"
  },
  "paths": {
    "/get_overall_health": {
      "post": {
        "operationId": "get_overall_health",
        "summary": "Get overall AWS environment health",
        "description": "Returns a combined health overview including EC2 instance states, active CloudWatch alarms, and Lambda function count. Use this as the first call for a general status check.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query (e.g. us-east-1, us-west-2, eu-west-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Overall health summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "overall_status": { "type": "string" },
                    "timestamp": { "type": "string" },
                    "ec2": { "type": "object" },
                    "active_alarms": { "type": "integer" },
                    "lambda_functions": { "type": "integer" },
                    "recommendation": { "type": "string" },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_ec2_health": {
      "post": {
        "operationId": "get_ec2_health",
        "summary": "Get EC2 instance health",
        "description": "Returns a list of EC2 instances with their state, type, IP addresses and availability zone. Can filter by instance state.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "state": {
                    "type": "string",
                    "description": "Filter by instance state: pending, running, shutting-down, stopping, stopped, terminated, all. Default: all"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EC2 health data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": { "type": "object" },
                    "instances": { "type": "array", "items": { "type": "object" } },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_lambda_health": {
      "post": {
        "operationId": "get_lambda_health",
        "summary": "Get Lambda function health and error rates",
        "description": "Returns Lambda functions with invocation counts, error rates, throttles, and average duration from CloudWatch metrics.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "prefix": {
                    "type": "string",
                    "description": "Filter functions by name prefix"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Number of hours to look back for metrics. Default: 24"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lambda health data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period_hours": { "type": "integer" },
                    "total_functions": { "type": "integer" },
                    "functions": { "type": "array", "items": { "type": "object" } },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_logs_analysis": {
      "post": {
        "operationId": "get_logs_analysis",
        "summary": "Query CloudWatch Logs Insights for errors and patterns",
        "description": "Runs a CloudWatch Logs Insights query on a log group to find errors, exceptions, and patterns. Use this to diagnose why a Lambda function or service is failing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["log_group"],
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "log_group": {
                    "type": "string",
                    "description": "CloudWatch log group name (e.g. /aws/lambda/my-function)"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Number of hours to look back. Default: 1, max: 24"
                  },
                  "query": {
                    "type": "string",
                    "description": "CloudWatch Logs Insights query string. Defaults to filtering ERROR/Exception/WARN messages."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log query results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "log_group": { "type": "string" },
                    "period_hours": { "type": "integer" },
                    "query": { "type": "string" },
                    "status": { "type": "string" },
                    "total_events": { "type": "integer" },
                    "error_events": { "type": "integer" },
                    "statistics": { "type": "object" },
                    "events": { "type": "array", "items": { "type": "object" } },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_xray_traces": {
      "post": {
        "operationId": "get_xray_traces",
        "summary": "Get X-Ray trace summaries to identify slow or failing requests",
        "description": "Returns X-Ray distributed trace summaries showing which services are slow or throwing errors. Use this to find root cause in multi-service flows.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Number of hours to look back. Default: 1, max: 6"
                  },
                  "filter_expression": {
                    "type": "string",
                    "description": "X-Ray filter expression (e.g. error = true, fault = true, responsetime > 2)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "X-Ray trace summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period_hours": { "type": "integer" },
                    "total_traces": { "type": "integer" },
                    "summary": { "type": "object" },
                    "traces": { "type": "array", "items": { "type": "object" } },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_cloudwatch_alarms": {
      "post": {
        "operationId": "get_cloudwatch_alarms",
        "summary": "Get CloudWatch alarms",
        "description": "Returns CloudWatch metric and composite alarms, filtered by state. Use state=ALARM to see only firing alarms.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "state": {
                    "type": "string",
                    "description": "Filter by alarm state: ALARM, OK, INSUFFICIENT_DATA, or ALL. Default: ALARM"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CloudWatch alarms data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": { "type": "object" },
                    "alarms": { "type": "array", "items": { "type": "object" } },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_ssm_inventory": {
      "post": {
        "operationId": "get_ssm_inventory",
        "summary": "Get SSM Inventory for EC2 instances",
        "description": "Returns SSM Inventory data for EC2 instances managed by SSM Agent: OS details, installed applications and versions, AWS components, network configuration. Requires SSM Agent running and AmazonSSMManagedInstanceCore IAM role attached to the instance.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instance_id": {
                    "type": "string",
                    "description": "Optional EC2 instance ID (e.g. i-0abc123). If omitted, returns inventory for all managed instances."
                  },
                  "inventory_type": {
                    "type": "string",
                    "description": "Type of inventory: OS, Application, Network, AWSComponent, or All. Default: All"
                  },
                  "region": {
                    "type": "string",
                    "description": "AWS region to query (e.g. us-east-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSM Inventory data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "managed_instance_count": { "type": "integer" },
                    "instances": { "type": "array", "items": { "type": "object" } },
                    "inventory": { "type": "array", "items": { "type": "object" } },
                    "note": { "type": "string" },
                    "region": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}