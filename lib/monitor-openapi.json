{
  "openapi": "3.0.0",
  "info": {
    "title": "AWS Monitor Actions",
    "version": "1.0.0",
    "description": "Action group for AWS health monitoring agent"
  },
  "paths": {
    "/get_overall_health": {
      "post": {
        "operationId": "get_overall_health",
        "summary": "Get overall AWS environment health",
        "description": "Returns a combined health overview including EC2 instance states, active CloudWatch alarms, and Lambda function count. Use this as the first call for a general status check.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query (e.g. us-east-1, us-west-2, eu-west-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Overall health summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "overall_status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "ec2": {
                      "type": "object"
                    },
                    "active_alarms": {
                      "type": "integer"
                    },
                    "lambda_functions": {
                      "type": "integer"
                    },
                    "recommendation": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_ec2_health": {
      "post": {
        "operationId": "get_ec2_health",
        "summary": "Get EC2 instance health",
        "description": "Returns a list of EC2 instances with their state, type, IP addresses and availability zone. Can filter by instance state.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "state": {
                    "type": "string",
                    "description": "Filter by instance state: pending, running, shutting-down, stopping, stopped, terminated, all. Default: all"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EC2 health data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "object"
                    },
                    "instances": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_lambda_health": {
      "post": {
        "operationId": "get_lambda_health",
        "summary": "Get Lambda function health and error rates",
        "description": "Returns Lambda functions with invocation counts, error rates, throttles, and average duration from CloudWatch metrics.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "prefix": {
                    "type": "string",
                    "description": "Filter functions by name prefix"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Number of hours to look back for metrics. Default: 24"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lambda health data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period_hours": {
                      "type": "integer"
                    },
                    "total_functions": {
                      "type": "integer"
                    },
                    "functions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_logs_analysis": {
      "post": {
        "operationId": "get_logs_analysis",
        "summary": "Query CloudWatch Logs Insights for errors and patterns",
        "description": "Runs a CloudWatch Logs Insights query on a log group to find errors, exceptions, and patterns. Use this to diagnose why a Lambda function or service is failing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "log_group"
                ],
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "log_group": {
                    "type": "string",
                    "description": "CloudWatch log group name (e.g. /aws/lambda/my-function)"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Number of hours to look back. Default: 1, max: 24"
                  },
                  "query": {
                    "type": "string",
                    "description": "CloudWatch Logs Insights query string. Defaults to filtering ERROR/Exception/WARN messages."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log query results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "log_group": {
                      "type": "string"
                    },
                    "period_hours": {
                      "type": "integer"
                    },
                    "query": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "total_events": {
                      "type": "integer"
                    },
                    "error_events": {
                      "type": "integer"
                    },
                    "statistics": {
                      "type": "object"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_xray_traces": {
      "post": {
        "operationId": "get_xray_traces",
        "summary": "Get X-Ray trace summaries to identify slow or failing requests",
        "description": "Returns X-Ray distributed trace summaries showing which services are slow or throwing errors. Use this to find root cause in multi-service flows.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Number of hours to look back. Default: 1, max: 6"
                  },
                  "filter_expression": {
                    "type": "string",
                    "description": "X-Ray filter expression (e.g. error = true, fault = true, responsetime > 2)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "X-Ray trace summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period_hours": {
                      "type": "integer"
                    },
                    "total_traces": {
                      "type": "integer"
                    },
                    "summary": {
                      "type": "object"
                    },
                    "traces": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_cloudwatch_alarms": {
      "post": {
        "operationId": "get_cloudwatch_alarms",
        "summary": "Get CloudWatch alarms",
        "description": "Returns CloudWatch metric and composite alarms, filtered by state. Use state=ALARM to see only firing alarms.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  },
                  "state": {
                    "type": "string",
                    "description": "Filter by alarm state: ALARM, OK, INSUFFICIENT_DATA, or ALL. Default: ALARM"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CloudWatch alarms data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "object"
                    },
                    "alarms": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_ssm_inventory": {
      "post": {
        "operationId": "get_ssm_inventory",
        "summary": "Get SSM Inventory for EC2 instances",
        "description": "Returns SSM Inventory data for EC2 instances managed by SSM Agent: OS details, installed applications and versions, AWS components, network configuration. Requires SSM Agent running and AmazonSSMManagedInstanceCore IAM role attached to the instance.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instance_id": {
                    "type": "string",
                    "description": "Optional EC2 instance ID (e.g. i-0abc123). If omitted, returns inventory for all managed instances."
                  },
                  "inventory_type": {
                    "type": "string",
                    "description": "Type of inventory: OS, Application, Network, AWSComponent, or All. Default: All"
                  },
                  "region": {
                    "type": "string",
                    "description": "AWS region to query (e.g. us-east-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSM Inventory data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "managed_instance_count": {
                      "type": "integer"
                    },
                    "instances": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "inventory": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "note": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_ec2_process_metrics": {
      "post": {
        "operationId": "get_ec2_process_metrics",
        "summary": "Get top EC2 processes by CPU or memory usage",
        "description": "Returns the top N processes consuming the most CPU or memory on EC2 instances, using CloudWatch Agent procstat metrics. Requires CloudWatch Agent with procstat plugin installed and running on the instances.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "description": "Metric to sort by: 'cpu' for CPU usage (%) or 'memory' for RAM usage (bytes/MB). Default: cpu"
                  },
                  "instance_id": {
                    "type": "string",
                    "description": "Optional EC2 instance ID (e.g. i-0abc123). If omitted, returns processes across all instances with CloudWatch Agent."
                  },
                  "top_n": {
                    "type": "integer",
                    "description": "Number of top processes to return. Default: 5, max: 20"
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Lookback window in hours for average calculation. Default: 1, max: 24"
                  },
                  "region": {
                    "type": "string",
                    "description": "AWS region to query. Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Top processes by CPU or memory usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "type": "string"
                    },
                    "instance_id": {
                      "type": "string"
                    },
                    "hours": {
                      "type": "integer"
                    },
                    "top_n": {
                      "type": "integer"
                    },
                    "total_processes_found": {
                      "type": "integer"
                    },
                    "processes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "note": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_ec2_instance_metrics": {
      "post": {
        "operationId": "get_ec2_instance_metrics",
        "summary": "Get EC2 instance CPU, network and disk metrics",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instance_id": {
                    "type": "string",
                    "description": "Optional EC2 instance ID (e.g. i-0abc123). If omitted, returns metrics for all running instances."
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Lookback period in hours (1-24). Default: 1"
                  },
                  "region": {
                    "type": "string",
                    "description": "AWS region (e.g. us-east-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EC2 instance metrics returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instances": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Returns CPU utilization, network in/out and disk read/write ops per EC2 instance using CloudWatch basic monitoring. No CloudWatch Agent required \u2014 works on all instances by default."
      }
    },
    "/get_alb_health": {
      "post": {
        "operationId": "get_alb_health",
        "summary": "Get Application Load Balancer health and traffic metrics",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alb_name": {
                    "type": "string",
                    "description": "Optional ALB name to filter. If omitted, returns all ALBs."
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Lookback period in hours (1-24). Default: 1"
                  },
                  "region": {
                    "type": "string",
                    "description": "AWS region (e.g. us-east-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ALB health metrics returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "load_balancers": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Returns request count, 4xx and 5xx error rates, average latency, and healthy/unhealthy host counts per ALB. Health is CRITICAL if unhealthy hosts > 0, WARNING if error rate > 5%."
      }
    },
    "/get_cloudtrail_activity": {
      "post": {
        "operationId": "get_cloudtrail_activity",
        "summary": "Get recent AWS API activity from CloudTrail",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "Optional IAM username or role to filter events by."
                  },
                  "event_name": {
                    "type": "string",
                    "description": "Optional CloudTrail event name to filter (e.g. DeleteBucket, TerminateInstances)."
                  },
                  "hours": {
                    "type": "integer",
                    "description": "Lookback period in hours (1-24). Default: 3"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Max events to return (1-50). Default: 20"
                  },
                  "region": {
                    "type": "string",
                    "description": "AWS region (e.g. us-east-1). Default: us-east-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CloudTrail events returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "object"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "region": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Returns recent AWS API calls from CloudTrail. Use for auditing who changed what, detecting unauthorized actions, or tracing configuration changes. Can filter by username or event name."
      }
    }
  }
}