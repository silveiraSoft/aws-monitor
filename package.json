{
  "name": "aws-monitor",
  "version": "0.1.0",
  "description": "AWS Health Monitor Agent with Bedrock Agent + Chat UI",
  "main": "bin/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy":      "npm run deploy:dev",
    "deploy:dev":  "cdk deploy --all --require-approval never --profile 3htpusa-monitor --context env=dev",
    "deploy:prod": "cdk deploy --all --require-approval never --profile aws-monitor-prod --context env=prod",
    "destroy":      "npm run destroy:dev",
    "destroy:dev":  "cdk destroy --all --profile 3htpusa-monitor --context env=dev",
    "destroy:prod": "cdk destroy --all --profile aws-monitor-prod --context env=prod"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.150.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.0.0"
  }
}
